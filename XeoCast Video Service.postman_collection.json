{
	"info": {
		"_postman_id": "YOUR_POSTMAN_COLLECTION_ID",
		"name": "XeoCast Video Service",
		"description": "Collection for interacting with the XeoCast Video Generation and Publishing API.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Configuration",
			"description": "Define environment variables here for baseUrl and apiKey.",
			"item": []
		},
		{
			"name": "Health",
			"item": [
				{
					"name": "GET Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/health",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"health"
							]
						},
						"description": "Checks the operational status of the API service. No authentication required."
					},
					"response": []
				}
			]
		},
		{
			"name": "Tasks",
			"description": "Endpoints for managing and querying tasks. Requires API Key authentication.",
			"item": [
				{
					"name": "GET List All Tasks",
					"request": {
						"auth": {
							"type": "apikey",
							"apikey": [
								{
									"key": "value",
									"value": "{{apiKey}}",
									"type": "string"
								},
								{
									"key": "key",
									"value": "X-API-Key",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/tasks/",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"tasks",
								""
							]
						},
						"description": "Retrieves metadata for all tasks known to the service. Requires `X-API-Key` header."
					},
					"response": []
				},
				{
					"name": "GET Task Status",
					"request": {
						"auth": {
							"type": "apikey",
							"apikey": [
								{
									"key": "value",
									"value": "{{apiKey}}",
									"type": "string"
								},
								{
									"key": "key",
									"value": "X-API-Key",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/tasks/YOUR_TASK_ID",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"tasks",
								"YOUR_TASK_ID"
							]
						},
						"description": "Retrieves metadata for a specific task using its unique ID. Requires `X-API-Key` header. Replace `YOUR_TASK_ID` with an actual task ID."
					},
					"response": []
				}
			]
		},
		{
			"name": "Video",
			"description": "Endpoints for generating and publishing videos. Requires API Key authentication.",
			"item": [
				{
					"name": "POST Generate Video",
					"request": {
						"auth": {
							"type": "apikey",
							"apikey": [
								{
									"key": "value",
									"value": "{{apiKey}}",
									"type": "string"
								},
								{
									"key": "key",
									"value": "X-API-Key",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/generate-video?background_image_url=YOUR_IMAGE_URL&audio_file_url=YOUR_AUDIO_URL&callback_url=YOUR_CALLBACK_URL&youtube_api_key=YOUR_YOUTUBE_API_KEY&youtube_video_title=Video Title&youtube_video_description=Video Description&youtube_video_tags=tag1,tag2&youtube_video_thumbnail_url=YOUR_THUMBNAIL_URL&youtube_video_playlist_id=YOUR_PLAYLIST_ID",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"generate-video"
							],
							"query": [
								{
									"key": "background_image_url",
									"value": "YOUR_IMAGE_URL",
									"description": "(Required) The full URL of the background image file."
								},
								{
									"key": "audio_file_url",
									"value": "YOUR_AUDIO_URL",
									"description": "(Required) The full URL of the audio file."
								},
								{
									"key": "callback_url",
									"value": "YOUR_CALLBACK_URL",
									"description": "(Required) The URL where the service will send results upon completion or error."
								},
								{
									"key": "youtube_api_key",
									"value": "YOUR_YOUTUBE_API_KEY",
									"description": "(Optional) YouTube API key for uploading.",
									"disabled": true
								},
								{
									"key": "youtube_video_title",
									"value": "Video Title",
									"description": "(Optional) Title for the YouTube video.",
									"disabled": true
								},
								{
									"key": "youtube_video_description",
									"value": "Video Description",
									"description": "(Optional) Description for the YouTube video.",
									"disabled": true
								},
								{
									"key": "youtube_video_tags",
									"value": "tag1,tag2",
									"description": "(Optional) Comma-separated tags for the YouTube video.",
									"disabled": true
								},
								{
									"key": "youtube_video_thumbnail_url",
									"value": "YOUR_THUMBNAIL_URL",
									"description": "(Optional) URL for the YouTube video thumbnail.",
									"disabled": true
								},
								{
									"key": "youtube_video_playlist_id",
									"value": "YOUR_PLAYLIST_ID",
									"description": "(Optional) YouTube playlist ID to add the video to.",
									"disabled": true
								}
							]
						},
						"description": "Initiates an asynchronous task to generate a video from a background image URL and an audio file URL. Requires `X-API-Key` header. All parameters are passed via query strings. Optional YouTube parameters are disabled by default."
					},
					"response": []
				},
				{
					"name": "POST Publish Video",
					"request": {
						"auth": {
							"type": "apikey",
							"apikey": [
								{
									"key": "value",
									"value": "{{apiKey}}",
									"type": "string"
								},
								{
									"key": "key",
									"value": "X-API-Key",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/publish-video?video_url=YOUR_VIDEO_URL&callback_url=YOUR_CALLBACK_URL&youtube_api_key=YOUR_YOUTUBE_API_KEY&youtube_video_title=Video Title&youtube_video_description=Video Description&youtube_video_tags=tag1,tag2&youtube_video_thumbnail_url=YOUR_THUMBNAIL_URL&youtube_video_playlist_id=YOUR_PLAYLIST_ID",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"publish-video"
							],
							"query": [
								{
									"key": "video_url",
									"value": "YOUR_VIDEO_URL",
									"description": "(Required) The full URL of the video file to publish."
								},
								{
									"key": "callback_url",
									"value": "YOUR_CALLBACK_URL",
									"description": "(Required) The URL where the service will send results upon completion or error."
								},
								{
									"key": "youtube_api_key",
									"value": "YOUR_YOUTUBE_API_KEY",
									"description": "(Required) YouTube API key for uploading."
								},
								{
									"key": "youtube_video_title",
									"value": "Video Title",
									"description": "(Required) Title for the YouTube video."
								},
								{
									"key": "youtube_video_description",
									"value": "Video Description",
									"description": "(Required) Description for the YouTube video."
								},
								{
									"key": "youtube_video_tags",
									"value": "tag1,tag2",
									"description": "(Required) Comma-separated tags for the YouTube video."
								},
								{
									"key": "youtube_video_thumbnail_url",
									"value": "YOUR_THUMBNAIL_URL",
									"description": "(Required) URL for the YouTube video thumbnail."
								},
								{
									"key": "youtube_video_playlist_id",
									"value": "YOUR_PLAYLIST_ID",
									"description": "(Required) YouTube playlist ID to add the video to."
								}
							]
						},
						"description": "Publishes a pre-existing video (from a URL) to YouTube. Requires `X-API-Key` header. All parameters are passed via query strings."
					},
					"response": []
				}
			]
		},
		{
			"name": "Static Files",
			"description": "Accessing generated static files (e.g., videos). Requires a signed URL.",
			"item": [
				{
					"name": "GET Access Generated Video (Example)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/static/YOUR_GENERATED_FILENAME.mp4?expires=TIMESTAMP&signature=GENERATED_SIGNATURE",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"static",
								"YOUR_GENERATED_FILENAME.mp4"
							],
							"query": [
								{
									"key": "expires",
									"value": "TIMESTAMP",
									"description": "The expiration timestamp used to generate the signature."
								},
								{
									"key": "signature",
									"value": "GENERATED_SIGNATURE",
									"description": "The generated signature for the path and expiry."
								}
							]
						},
						"description": "Example request to access a generated static file. Replace `YOUR_GENERATED_FILENAME.mp4` with the actual filename. The `expires` and `signature` parameters must be generated by your application (using `signature_service.generate_signed_url`) and appended to the URL. This endpoint does NOT use the API Key."
					},
					"response": []
				}
			]
		},
		{
			"name": "Testing",
			"item": [
				{
					"name": "POST Test Callback Receiver",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"message\": \"This is a test payload\",\n    \"data\": {\n        \"key1\": \"value1\",\n        \"key2\": 123\n    }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/test-callback",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"test-callback"
							]
						},
						"description": "A simple endpoint that accepts any JSON POST payload and logs it. Useful for verifying that your callback mechanism works or for setting up a mock receiver during development. No authentication required."
					},
					"response": []
				}
			]
		}
	],
	"auth": {
		"type": "apikey",
		"apikey": [
			{
				"key": "value",
				"value": "{{apiKey}}",
				"type": "string"
			},
			{
				"key": "key",
				"value": "X-API-Key",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8000",
			"type": "string",
			"description": "The base URL for the API service."
		},
		{
			"key": "apiKey",
			"value": "YOUR_API_KEY",
			"type": "string",
			"description": "Your API Key for accessing protected endpoints."
		}
	]
} 